# Local dev: SQLite. Switch to Postgres URL for Supabase.
DATABASE_URL="file:./dev.db"

# Escape hatch to run the single dev user against a production build.
# Never enable on a real deployment.
# ALLOW_DEV_AUTH=true

# AI insight callouts (in use today) — https://open.bigmodel.cn
# ZAI_API_KEY=
# ZAI_MODEL=glm-4-flash

# Phase 3+
# RESEND_API_KEY=         # https://resend.com/api-keys — daily/weekly/milestone emails
# RESEND_FROM="Ashe Ra <hello@yourdomain.com>"   # must be a verified Resend sender
# CRON_SECRET=            # random string; protects /api/cron/reminders
# NEXT_PUBLIC_APP_URL=https://journal.ashera.com  # used in email links

# Future phase: real auth (see README "Switching to Supabase + Postgres later")
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
